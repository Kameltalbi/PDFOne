{
  "name": "mini-pdf-tools",
  "version": "1.0.0",
  "description": "Mini PDF Tools - Web-based PDF processing application",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "lint": "npm run lint --workspace=client && npm run lint --workspace=server",
    "setup:conversion-engine": "python3 -m venv conversion-engine/.venv && conversion-engine/.venv/bin/python -m pip install --upgrade pip setuptools && conversion-engine/.venv/bin/pip install -e 'conversion-engine[test,vision]'",
    "test:conversion-engine": "conversion-engine/.venv/bin/pytest conversion-engine/tests",
    "test:pdf-to-excel": "conversion-engine/.venv/bin/pytest conversion-engine/tests/pdf_to_excel",
    "test:pdf-to-image": "conversion-engine/.venv/bin/pytest conversion-engine/tests/pdf_to_image",
    "quality:conversion-engine": "conversion-engine/.venv/bin/python conversion-engine/scripts/quality_report.py",
    "quality:pdf-to-excel": "conversion-engine/.venv/bin/python conversion-engine/scripts/excel_quality_report.py",
    "clean": "rm -rf client/dist server/dist temp/*",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "test:e2e:mint-pro": "node e2e/scripts/mint-pro-access.mjs",
    "test:e2e:chromium": "playwright test -c e2e/playwright.config.ts --project=chromium-desktop",
    "test:e2e:webkit": "playwright test -c e2e/playwright.config.ts --project=webkit-desktop",
    "test:e2e:mobile": "playwright test -c e2e/playwright.config.ts --project=mobile-safari"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
