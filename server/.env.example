PORT=3002
NODE_ENV=development
MAX_FILE_SIZE=1073741824
MAX_FILES=20
TEMP_FILE_TTL=900000
PDF_CONCURRENCY=2
PDF_MAX_WAITING=20
OFFICE_CONCURRENCY=1
OFFICE_MAX_WAITING=10
OCR_CONCURRENCY=1
OCR_MAX_WAITING=10
HEAVY_WORKERS=1
RASTER_MAX_PIXELS=12000000
PDF_TO_IMAGE_ENGINE=v1
PDF_TO_IMAGE_PYTHON_PATH=python3
PDF_TO_IMAGE_QUALITY_LEVEL=standard
# Overrides quality level when set: Standard=150, High=200, Very High=300.
PDF_TO_IMAGE_DPI=150
PDF_TO_IMAGE_MAX_PAGES=200
PDF_TO_IMAGE_MAX_DIMENSION=10000
PDF_TO_IMAGE_RUN_TIMEOUT_MS=300000
QUEUE_WAIT_TIMEOUT_MS=120000
PDF_RUN_TIMEOUT_MS=300000
OFFICE_RUN_TIMEOUT_MS=600000
PDF2DOCX_RUN_TIMEOUT_MS=300000
PDF2DOCX_MAX_PAGES=200
PDF2DOCX_MAX_IMAGE_PIXELS=24000000
PDF_TO_EXCEL_ENGINE=v1
PDF2EXCEL_PYTHON_PATH=python3
PDF2EXCEL_RUN_TIMEOUT_MS=300000
PDF2EXCEL_MAX_PAGES=200
PDF2EXCEL_MAX_WORDS=500000
OCR_RUN_TIMEOUT_MS=600000
MIN_FREE_TEMP_BYTES=536870912
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
APP_URL=http://localhost:5174
# Required in production (≥32 chars, not a placeholder). Locally you may set SESSION_SECRET
# or SESSION_SECRET_DEV; if both are unset, the server uses an ephemeral per-process secret.
SESSION_SECRET=change-me-in-production-use-a-long-random-value
# SESSION_SECRET_DEV=
# Comma-separated browser origins allowed with credentials (plus APP_URL and built-in defaults).
CORS_ORIGINS=
FREE_DAILY_DOCS=3
ADMIN_SECRET=
# Comma-separated superadmin emails (never hardcode identities in source).
SUPERADMIN_EMAILS=
TRANSLATE_FONT_PATH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ONE2PDF_YEAR_PRODUCT_ID=
LIBREOFFICE_PATH=
# Python interpreter with conversion-engine dependencies installed.
PDF2DOCX_PYTHON_PATH=python3
TESSERACT_PATH=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
